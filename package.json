{
  "name": "@dsh-external/dsh-org-panel",
  "version": "0.0.1",
  "description": "侧边栏组织面板：复用 OMC 办公室渲染，实时显示 DSH 子代理/员工状态",
  "license": "BSD-3-Clause",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "public"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
